# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=your_mongodb_atlas_uri

# Security (Strong unique keys)
JWT_SECRET=your_jwt_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URLs (Must match production endpoints)
CLIENT_URL=https://your-frontend-domain.com
API_URL=https://your-backend-domain.com/api

# AI (Google Gemini)
# Primary key
GEMINI_API_KEY=your_gemini_api_key
# Fallback keys (You can add as many as you want: _2, _3, ..., _10, etc.)
# The system will automatically rotate to the next key if the current one hits a quota limit.
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key
# GEMINI_API_KEY_10=...

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Unsplash (Visual sourcing)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
